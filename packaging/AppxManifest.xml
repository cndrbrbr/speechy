<?xml version="1.0" encoding="utf-8"?>
<!-- Identity package with external location: contains no program files.
     The registered Speechy folder supplies .speechy-venv\Scripts\pythonw.exe.
     Name and Publisher must match scripts/win_identity.py. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10 desktop6 rescap">
  <Identity Name="Speechy.Local" Publisher="CN=Speechy Local Identity" Version="1.0.0.0" ProcessorArchitecture="neutral" />
  <Properties>
    <DisplayName>Speechy</DisplayName>
    <PublisherDisplayName>Speechy</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
    <!-- Write state.json, models and voices to the real folders, as without identity. -->
    <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
    <desktop6:RegistryWriteVirtualization>disabled</desktop6:RegistryWriteVirtualization>
  </Properties>
  <Resources>
    <Resource Language="de-de" />
  </Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
    <DeviceCapability Name="microphone" />
  </Capabilities>
  <Applications>
    <!-- sys.executable is the venv's pythonw.exe, so parents[2] is the registered Speechy folder. -->
    <Application Id="Speechy" Executable=".speechy-venv\Scripts\pythonw.exe"
      uap10:Parameters="-I -c &quot;import runpy, sys; from pathlib import Path; runpy.run_path(str(Path(sys.executable).parents[2] / 'scripts' / 'bootstrap.py'), run_name='__main__')&quot; --identity-launch"
      uap10:TrustLevel="mediumIL" uap10:RuntimeBehavior="win32App">
      <uap:VisualElements DisplayName="Speechy" Description="PDF-Vorleser und Spracherkennung"
        BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>
</Package>
